{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "cmake",
			"type": "shell",
			"command": "sh",
			"args": [
				"${workspaceFolder}/scripts/cmake.sh"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "make",
			"type": "shell",
			"command": "sh",
			"args": [
				"${workspaceFolder}/scripts/make.sh"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "format",
			"type": "shell",
			"command": "sh",
			"args": [
				"${workspaceFolder}/scripts/format.sh"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "lint",
			"type": "shell",
			"command": "sh",
			"args": [
				"${workspaceFolder}/scripts/tidy.sh"
			],
			"isBackground": false,
			"problemMatcher": {
				"owner": "clang-tidy",
				"fileLocation": "absolute",
				"pattern": {
					"regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5
				}
			}
		},
	]
}
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Falcon (lldb-dap)",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/falcon",
            "args": [
                "my_graph.yaml",
                "-a"
            ],
            "cwd": "${workspaceFolder}/build/debug",
            "preLaunchTask": "make",
            "console": "integratedTerminal",
            "initCommands": [
                // TODO(ben): temp solution to prevent lldb hanging, remove
                "settings set symbols.enable-external-lookup false"
            ]
        }
    ]
}
{
    "version": "0.2.0",
    "inputs": [
        {
            "id": "coreFilePath",
            "type": "promptString",
            "description": "Path to the core dump file",
            "default": "${workspaceFolder}/build/output/core"
        },
        {
            "id": "processId",
            "type": "promptString",
            "description": "PID of the running falcon process (pgrep falcon)"
        }
    ],
    "configurations": [
        {
            "name": "Debug Falcon",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/output/falcon",
            "args": [],
            "cwd": "${workspaceFolder}/build/output",
            "preLaunchTask": "make",
            "console": "integratedTerminal"
        },
        {
            // Attaches to an already running falcon, found by its binary path.
            // Needs ptrace permission: same user and kernel.yama.ptrace_scope=0, or root.
            "name": "Attach to running Falcon",
            "type": "lldb-dap",
            "request": "attach",
            "program": "${workspaceFolder}/build/output/falcon"
        },
        {
            // Attaches to a running falcon by PID, for when several falcon processes run.
            "name": "Attach to Falcon by PID",
            "type": "lldb-dap",
            "request": "attach",
            "program": "${workspaceFolder}/build/output/falcon",
            // The prompt returns a string and "pid" requires a number, so attach through an lldb command.
            "attachCommands": [
                "process attach --pid ${input:processId}"
            ]
        },
        {
            // Waits for the next falcon to start, then attaches to it.
            // Start this first, then run falcon from a terminal (e.g. under chrt/taskset).
            "name": "Attach to next Falcon launch",
            "type": "lldb-dap",
            "request": "attach",
            "program": "${workspaceFolder}/build/output/falcon",
            "waitFor": true
        },
        {
            // Opens a core dump for post-mortem inspection of a crash.
            "name": "Debug Falcon core dump",
            "type": "lldb-dap",
            "request": "attach",
            "program": "${workspaceFolder}/build/output/falcon",
            "coreFile": "${input:coreFilePath}"
        }
    ]
}

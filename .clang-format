BasedOnStyle: Google

# Indentation / spacing (clean, modern, Java-like)
IndentWidth: 4
TabWidth: 4
UseTab: Never
AccessModifierOffset: -4   # private: in line with class
ColumnLimit: 100
SpaceBeforeParens: ControlStatements
PointerAlignment: Left
DerivePointerAlignment: false
Cpp11BracedListStyle: true

# Modern readability
AllowShortFunctionsOnASingleLine: InlineOnly
ReflowComments: true
AlignTrailingComments: true

# Avoid legacy-C++ visual alignment
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignConsecutiveMacros: false
AlignConsecutiveBitFields: false

# Include handling
SortIncludes: true
IncludeBlocks: Preserve

# Consistent indentation rules
IndentCaseLabels: true
IndentGotoLabels: true

# Extra modern preferences
BreakBeforeBraces: Attach
InsertBraces: true   # braces everywhere, as .clang-tidy requires
SpacesInParentheses: false
SpacesInAngles: false
SpaceBeforeRangeBasedForLoopColon: true
SpaceAroundPointerQualifiers: Default

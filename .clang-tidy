Checks:
  - '-*'
  - performance-*
  - bugprone-*
  - modernize-*
  - readability-*
  - -bugprone-suspicious-include          # falcon is .cpp only
  - -modernize-use-trailing-return-type   # leading return types
  - -readability-magic-numbers            # pipeline parameters

WarningsAsErrors: '*'
# A processor template is analyzed only where a pipeline instantiates it, so report into included files.
HeaderFilterRegex: '(^|.*/)src/.*'
# Not ExtraArgs: it lands after the "--" in borrowed compile commands, where it reads as a file name.
ExtraArgsBefore:
  - '-Wno-pragma-once-outside-header'
CheckOptions:
  - key: readability-identifier-naming.TypedefCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.GlobalConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.ClassConstantCase
    value: lower_case   # Stream::vectors, like std::numeric_limits<float>::digits; else GlobalConstantCase applies
  - key: readability-identifier-naming.MemberCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key: readability-identifier-length.IgnoredParameterNames
    value: '^$'         # none
  - key: readability-identifier-length.IgnoredVariableNames
    value: '^_$'        # unused variable
  - key: readability-identifier-length.MinimumLoopCounterNameLength
    value: 3            # no i, j
  - key: readability-identifier-length.IgnoredLoopCounterNames
    value: '^$'         # none
  - key: readability-identifier-length.MinimumExceptionNameLength
    value: 3            # no e
  - key: readability-identifier-length.IgnoredExceptionVariableNames
    value: '^$'         # none
  - key: readability-uppercase-literal-suffix.NewSuffixes
    value: 'L;LL;UL;ULL;LU;LLU'   # flag only l (looks like 1)
  - key: readability-implicit-bool-conversion.AllowPointerConditions
    value: true                    # if (ptr)
  - key: bugprone-signed-bitwise.IgnorePositiveIntegerLiterals
    value: true                    # GL_A | GL_B
  - key: misc-assert-side-effect.CheckFunctionCalls
    value: 1
  - key: misc-assert-side-effect.AssertMacros
    value: 'assert'